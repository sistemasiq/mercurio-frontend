# Variables del stack de docker-compose.yml. Los valores de abajo son los
# GENÉRICOS que el compose usa por defecto: sirven para levantar y probar, pero
# deben cambiarse antes de producción. Copia este archivo a .env.docker (ignorado
# por git), cámbialos y levanta con: docker compose --env-file .env.docker up -d

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=woowkids

# API
SECRET_KEY=woowkids-secret-key-cambiar-en-produccion
# true solo si se sirve por HTTPS.
COOKIE_SECURE=false
# true carga sql/seed_local.sql (sucursal, usuarios y catálogo de prueba) la
# primera vez que se crea la BD.
SEED_DEMO=false

# Administrador de sistema inicial (se crea solo si el correo no existe)
ADMIN_EMAIL=admin@woowkids.com
ADMIN_PASSWORD=admin1234

# MinIO (mínimo 8 caracteres en la contraseña)
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin1234
MINIO_BUCKET=woowkids

# Imágenes: tag publicado por los workflows de release (vX.Y.Z o latest)
FRONTEND_TAG=local
BACKEND_TAG=latest

# Puertos en el host
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
